# OpenShift & Data Science Pipelines Configuration Template
# Copy this to .env and fill in your values: cp .env.example .env

# OpenShift User Token (extract via `oc whoami -t` or Web Console)
OCP_TOKEN=sha256~your-token-here

# DSPA (Data Science Pipelines Application) Route URL
# Run: oc get route -l app.kubernetes.io/name=data-science-pipelines -o jsonpath='{"https://"}{.items[0].spec.host}'
DSPA_HOST=https://ds-pipeline-dspa-my-project.apps.mycluster.domain.com

# OpenShift Project / Namespace
NAMESPACE=my-data-science-project

# SSL Certificate verification (set to False if your cluster uses internal/self-signed certs)
VERIFY_SSL=True

# GPU count per task (use 0 for trial clusters without physical GPUs)
NUM_GPUS=1
